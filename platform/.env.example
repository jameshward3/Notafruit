# Orange platform — copy to .env. NEVER commit real values.
# --- Core
DATABASE_URL=postgres://orange:CHANGE_ME@localhost:5432/orange_platform
POSTGRES_PASSWORD=CHANGE_ME
PAYLOAD_SECRET=                 # >= 32 random chars: openssl rand -base64 48
PUBLIC_SITE_URL=http://localhost:3000

# --- Staff sign-in: "local" (development only) or "proxy" (production, IdP with MFA via identity-aware proxy)
AUTH_MODE=local
AUTH_PROXY_SHARED_SECRET=       # required when AUTH_MODE=proxy (>= 32 chars), injected by the proxy only

# --- Object storage (unset S3_BUCKET = local ./media directory)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PRIVATE_UPLOAD_DIR=private-uploads/imports   # outside the web root; import CSVs

# --- Mail: "capture" (writes private-uploads/mail-capture/outbox.jsonl, sends nothing) or "smtp"
MAIL_TRANSPORT=capture
MAIL_FROM=City of Orange Township <no-reply@example.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Geocoding: "none" (default), "fixture" (dev only, labeled), "census" (US Census geocoder; allow outbound host)
GEOCODER_PROVIDER=none

# --- Basemap style JSON URL (MapLibre). Empty = data-only canvas. Respect the provider's usage terms.
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Rate limits (per hashed client key)
RATE_LIMIT_CONCERNS_PER_HOUR=5
RATE_LIMIT_SUBSCRIBE_PER_HOUR=10

# --- Worker
WORKER_INTERVAL_MS=30000

# --- Development seed only
SEED_STAFF_PASSWORD=

NEXT_PUBLIC_BASEMAP=osm               # osm (prototype only) | none
