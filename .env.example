# ClerkOS environment — copy to .env and edit before first start.
# NEVER commit the real .env.

# --- Core -------------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
CLERKOS_SECRET_KEY=change-me-generate-a-long-random-value
CLERKOS_DEBUG=false
CLERKOS_ALLOWED_HOSTS=clerkos.local,localhost
CLERKOS_CSRF_TRUSTED_ORIGINS=https://clerkos.local
CLERKOS_TIMEZONE=America/New_York

# --- Database ---------------------------------------------------------------
POSTGRES_DB=clerkos
POSTGRES_USER=clerkos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security policy ---------------------------------------------------------
CLERKOS_PASSWORD_MIN_LENGTH=12
CLERKOS_LOCKOUT_THRESHOLD=5
CLERKOS_LOCKOUT_MINUTES=15
CLERKOS_SESSION_TIMEOUT_MINUTES=30

# --- Documents / uploads ------------------------------------------------------
CLERKOS_DOCUMENT_ROOT=/data/documents
CLERKOS_MAX_UPLOAD_MB=100
CLERKOS_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.rtf,.png,.jpg,.jpeg,.tif,.tiff,.zip,.msg,.eml
# Optional antivirus hook (ClamAV): clamdscan --no-summary {path}
CLERKOS_ANTIVIRUS_COMMAND=

# --- Backups ------------------------------------------------------------------
CLERKOS_BACKUP_DIR=/backups

# --- Email (internal SMTP relay; console backend logs instead of sending) -----
CLERKOS_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CLERKOS_SMTP_HOST=localhost
CLERKOS_SMTP_PORT=25
CLERKOS_FROM_EMAIL=clerkos@clerkos.local

# --- Seed ----------------------------------------------------------------------
# Initial password for seeded users (all forced to change at first sign-in).
CLERKOS_SEED_PASSWORD=ChangeMe!2026

# --- Optional MinIO (docker compose --profile minio up) -------------------------
MINIO_ROOT_USER=clerkos
MINIO_ROOT_PASSWORD=change-me-minio
